{
  "expo": {
    "name": "ChainTrace Farmer",
    "slug": "chaintrace-farmer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "chaintrace",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chaintrace.farmer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090f"
      },
      "package": "com.chaintrace.farmer",
      "edgeToEdgeEnabled": true,
      "permissions": ["POST_NOTIFICATIONS", "INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00c896"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
